---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Livraria - Portal 1IPIM';
const description = 'Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade.';
---
<PortalLayout title={title} description={description}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4"> <div class="w-32 h-32 bg-indigo-50 dark:bg-indigo-900/30 rounded-[2.5rem] flex items-center justify-center text-indigo-500 text-5xl mb-8 animate-bounce shadow-inner"> <i class="fa-solid fa-book-open"></i> </div> <h1 class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white leading-tight tracking-tighter uppercase mb-4">
Livraria em <span class="text-[var(--color-brand)]">Construção</span> </h1> <p class="text-gray-500 dark:text-gray-400 max-w-lg text-lg leading-relaxed mb-10">
Estamos preparando um sistema completo para gestão do acervo literário e vendas da igreja. Em breve você poderá gerenciar o estoque aqui mesmo pelo portal.
</p> <div class="flex flex-wrap items-center justify-center gap-4"> <a href="/portal" class="bg-[var(--color-brand)] hover:bg-[var(--color-brand-dark)] text-white px-8 py-4 rounded-2xl font-black transition-all shadow-xl shadow-[var(--color-brand)]/20 uppercase text-xs tracking-widest">
Voltar ao Início
</a> <button class="px-8 py-4 bg-white dark:bg-slate-800 text-gray-400 font-bold rounded-2xl border border-gray-100 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700 transition-all uppercase text-xs tracking-widest cursor-not-allowed opacity-50">
Notificar quando pronto
</button> </div> <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-4xl"> <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-700 text-left"> <i class="fa-solid fa-check-circle text-[var(--color-brand)] mb-3"></i> <h4 class="font-bold text-gray-900 dark:text-white mb-1">Controle de Estoque</h4> <p class="text-xs text-gray-500">Gestão simplificada de entradas e saídas de livros.</p> </div> <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-700 text-left"> <i class="fa-solid fa-check-circle text-[var(--color-brand)] mb-3"></i> <h4 class="font-bold text-gray-900 dark:text-white mb-1">Catálogo Digital</h4> <p class="text-xs text-gray-500">Exibição de capas e resumos no site principal.</p> </div> <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-700 text-left"> <i class="fa-solid fa-check-circle text-[var(--color-brand)] mb-3"></i> <h4 class="font-bold text-gray-900 dark:text-white mb-1">Relatórios de Vendas</h4> <p class="text-xs text-gray-500">Histórico de saídas para prestação de contas.</p> </div> </div> </div>  
</PortalLayout>
