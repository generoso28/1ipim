---
import Layout from '../../layouts/Layout.astro';

const title = 'Cadastrar Voluntário - 1IPIM';
const description = 'Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade.';
---
<Layout title={title} description={description} noindex={true}>

<section class="py-24 mt-16 bg-white dark:bg-slate-900 transition-colors min-h-screen"> <div class="container mx-auto px-4 lg:px-8 max-w-2xl"> <!-- Auth Protection Overlay --> <div id="auth-guard" class="fixed inset-0 bg-white dark:bg-slate-900 z-[3000] flex items-center justify-center"> <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-[var(--color-brand)]"></div> </div> <!-- Header --> <div class="mb-12"> <a href="/portal/usuarios" class="text-[var(--color-brand)] font-bold text-sm hover:underline flex items-center gap-2 mb-4"> <i class="fa-solid fa-arrow-left"></i> Voltar para a Gestão
</a> <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight">Novo Voluntário</h1> <p class="text-gray-500 mt-2">Cadastre manualmente membros com dificuldade tecnológica.</p> </div> <!-- Form --> <form id="new-user-form" class="space-y-6 bg-gray-50 dark:bg-slate-800/50 p-8 rounded-[2rem] border border-gray-100 dark:border-slate-700 shadow-sm transition-all duration-300"> <div class="grid grid-cols-1 gap-6"> <div> <label for="user-name" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Nome Completo</label> <input type="text" id="user-name" name="name" required class="block w-full px-5 py-3.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl outline-none focus:ring-2 focus:ring-[var(--color-brand)]" placeholder="Ex: Maria de Souza"> </div> <div> <label for="user-email" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">E-mail</label> <input type="email" id="user-email" name="email" required class="block w-full px-5 py-3.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl outline-none focus:ring-2 focus:ring-[var(--color-brand)]" placeholder="maria@email.com"> </div> <div> <label for="user-login" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Nome de Usuário (Login)</label> <input type="text" id="user-login" name="username" required class="block w-full px-5 py-3.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl outline-none focus:ring-2 focus:ring-[var(--color-brand)]" placeholder="maria.souza"> </div> <div> <label class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Ministérios</label> <div id="ministries-grid" class="grid grid-cols-2 gap-3 bg-white dark:bg-slate-900 p-4 rounded-xl border border-gray-200 dark:border-slate-700 max-h-40 overflow-y-auto"> <!-- Injetado via JS --> </div> </div> </div> <div id="form-feedback" class="hidden p-5 rounded-xl text-sm font-bold flex items-center gap-3"></div> <button type="submit" id="submit-btn" class="w-full bg-[var(--color-brand)] hover:bg-[var(--color-brand-dark)] text-white font-bold py-4 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 group"> <span id="btn-text">Cadastrar e Aprovar</span> <i id="btn-loader" class="fa-solid fa-circle-notch animate-spin hidden"></i> </button> </form> </div> </section>
</Layout>

<script>
import '../../scripts/portal/novo-usuario.ts';
</script>
