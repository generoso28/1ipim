---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Notificações - Portal 1IPIM';
const description = 'Avisos internos do Portal 1IPIM.';
---
<PortalLayout title={title} description={description}>
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[var(--color-brand)] mb-2">Central de avisos</p>
      <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight tracking-tighter uppercase">Notificações</h1>
      <p class="text-gray-500 mt-2">Acompanhe aprovações, escalas, conflitos, estoque e avisos do portal.</p>
    </div>
    <button id="notifications-read-all" type="button" class="px-6 py-3 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase tracking-widest text-gray-600 dark:text-gray-300 hover:text-[var(--color-brand)]">
      Marcar todas como lidas
    </button>
  </div>

  <div id="notifications-loading" class="py-24 text-center">
    <div class="animate-spin inline-block w-10 h-10 border-[3px] border-current border-t-transparent text-[var(--color-brand)] rounded-full mb-4"></div>
    <p class="text-xs font-black text-gray-400 uppercase tracking-widest">Carregando notificações...</p>
  </div>
  <div id="notifications-empty" class="hidden py-24 text-center bg-gray-50/60 dark:bg-slate-800/30 rounded-[2rem] border-2 border-dashed border-gray-100 dark:border-slate-700">
    <i class="fa-solid fa-bell-slash text-5xl text-gray-200 mb-4"></i>
    <p class="text-gray-500 font-bold">Nenhuma notificação por aqui.</p>
  </div>
  <div id="notifications-list" class="hidden space-y-3"></div>
  <div class="flex items-center justify-between gap-4 mt-6">
    <p id="notifications-page-info" class="text-[11px] font-bold text-gray-500"></p>
    <div class="flex items-center gap-2">
      <button id="notifications-prev" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Anterior</button>
      <button id="notifications-next" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Próxima</button>
    </div>
  </div>
</PortalLayout>

<script>
  import '../../scripts/portal/notificacoes.ts';
</script>
