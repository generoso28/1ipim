---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Livraria - Portal 1IPIM';
const description = 'Gestão do catálogo, estoque e capas da livraria da 1IPIM.';
---
<PortalLayout title={title} description={description}>
  <div id="livraria-manager" class="space-y-8">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div>
        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[var(--color-brand)] mb-2">Ministério Livraria</p>
        <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight tracking-tighter uppercase">Catálogo</h1>
        <p class="text-gray-500 mt-2 max-w-2xl">Cadastre livros, organize categorias, acompanhe o estoque e escolha as capas. O catálogo público é atualizado automaticamente.</p>
      </div>
      <button id="livraria-new-btn" type="button" class="bg-[var(--color-brand)] hover:bg-[var(--color-brand-dark)] text-white px-7 py-4 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg shadow-[var(--color-brand)]/20 transition-all flex items-center justify-center gap-2">
        <i class="fa-solid fa-plus"></i> Novo livro
      </button>
    </div>

    <div id="livraria-stats" class="grid grid-cols-2 lg:grid-cols-4 gap-4"></div>

    <div class="bg-white dark:bg-slate-800 rounded-[2rem] border border-gray-100 dark:border-slate-700 p-5 md:p-6 shadow-sm">
      <div class="flex flex-col md:flex-row gap-3">
        <label class="flex-1 relative">
          <span class="sr-only">Buscar livros</span>
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <input id="livraria-search" type="search" placeholder="Buscar por título, autor, editora ou categoria..." class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
        </label>
        <label for="livraria-category" class="sr-only">Filtrar por categoria</label>
        <select id="livraria-category" aria-label="Filtrar por categoria" class="md:w-64 px-4 py-3.5 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-bold text-gray-600 dark:text-gray-300 outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
          <option value="">Todas as categorias</option>
        </select>
        <label class="flex items-center gap-2 px-4 py-3 rounded-2xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 text-xs font-black uppercase tracking-wider text-amber-800 dark:text-amber-300 whitespace-nowrap">
          <input id="livraria-low-stock" type="checkbox" class="w-4 h-4 rounded border-amber-300 text-amber-600"> Estoque baixo
        </label>
        <label class="flex items-center gap-2 px-4 py-3 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase tracking-wider text-gray-600 dark:text-gray-300 whitespace-nowrap">
          <input id="livraria-no-cover" type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[var(--color-brand)]"> Sem capa
        </label>
      </div>
    </div>

    <div id="livraria-loading" class="py-24 text-center">
      <div class="animate-spin inline-block w-10 h-10 border-[3px] border-current border-t-transparent text-[var(--color-brand)] rounded-full mb-4"></div>
      <p class="text-xs font-black text-gray-400 uppercase tracking-widest">Carregando catálogo...</p>
    </div>

    <div id="livraria-error" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800 text-red-600 dark:text-red-400 p-6 rounded-2xl text-sm font-bold"></div>
    <div id="livraria-empty" class="hidden py-24 text-center bg-gray-50/60 dark:bg-slate-800/30 rounded-[2rem] border-2 border-dashed border-gray-100 dark:border-slate-700">
      <i class="fa-solid fa-book-open text-5xl text-gray-200 mb-4"></i>
      <p class="text-gray-500 font-bold">Nenhum livro encontrado.</p>
    </div>

    <div id="livraria-list" class="hidden bg-white dark:bg-slate-800 rounded-[2rem] border border-gray-100 dark:border-slate-700 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[900px]">
          <thead>
            <tr class="border-b border-gray-100 dark:border-slate-700">
              <th class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">Livro</th>
              <th class="px-4 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">Categoria</th>
              <th class="px-4 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400">Preços</th>
              <th class="px-4 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400 text-center">Estoque</th>
              <th class="px-4 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400 text-center">Status</th>
              <th class="px-6 py-5 text-[10px] font-black uppercase tracking-widest text-gray-400 text-right">Ações</th>
            </tr>
          </thead>
          <tbody id="livraria-table-body"></tbody>
        </table>
      </div>
      <div class="flex items-center justify-between gap-4 px-6 py-4 border-t border-gray-100 dark:border-slate-700">
        <p id="livraria-page-info" class="text-[11px] font-bold text-gray-400"></p>
        <div class="flex items-center gap-2">
          <button id="livraria-prev" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Anterior</button>
          <button id="livraria-next" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Próxima</button>
        </div>
      </div>
    </div>
  </div>

  <div id="book-modal" class="fixed inset-0 z-[3000] hidden bg-black/75 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="min-h-full flex items-start justify-center py-6">
      <div class="bg-white dark:bg-slate-800 w-full max-w-4xl rounded-[2rem] shadow-2xl border border-white/10 overflow-hidden">
        <div class="flex items-center justify-between px-6 md:px-8 py-5 border-b border-gray-100 dark:border-slate-700">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-[var(--color-brand)]">Livraria</p>
            <h2 id="book-modal-title" class="text-2xl font-black text-gray-900 dark:text-white">Novo livro</h2>
          </div>
          <button id="book-modal-close" type="button" aria-label="Fechar" class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-slate-900 text-gray-400 hover:text-red-500 transition-colors">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <form id="book-form" class="p-6 md:p-8 space-y-6">
          <input id="book-id" type="hidden" value="">
          <input id="book-cover-url" type="hidden" value="">

          <div class="grid grid-cols-1 lg:grid-cols-[220px,1fr] gap-6">
            <div class="space-y-3">
              <div id="book-cover-preview" class="aspect-[3/4] w-full rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 overflow-hidden flex items-center justify-center text-gray-300">
                <i class="fa-solid fa-book-open text-4xl"></i>
              </div>
              <label class="block">
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Enviar capa</span>
                <input id="book-cover-file" type="file" accept="image/*" class="block w-full text-[11px] text-gray-500 file:mr-3 file:px-3 file:py-2 file:rounded-xl file:border-0 file:bg-gray-100 dark:file:bg-slate-700 file:text-gray-700 dark:file:text-gray-200 file:font-bold">
              </label>
              <button id="book-cover-search-btn" type="button" class="w-full py-2.5 rounded-xl bg-indigo-50 dark:bg-indigo-900/30 text-indigo-500 text-[11px] font-black uppercase tracking-widest hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors">
                <i class="fa-solid fa-magnifying-glass mr-1"></i> Buscar capa
              </button>
              <div id="cover-results" class="grid grid-cols-3 gap-2"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <label class="md:col-span-2">
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Título *</span>
                <input id="book-title" required class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-bold text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Subtítulo</span>
                <input id="book-subtitle" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Autor</span>
                <input id="book-author" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Editora</span>
                <input id="book-publisher" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Categoria</span>
                <input id="book-category" list="book-category-options" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
                <datalist id="book-category-options"></datalist>
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">ISBN</span>
                <input id="book-isbn" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Preço dinheiro</span>
                <input id="book-cash" inputmode="decimal" placeholder="20,00" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Preço cartão</span>
                <input id="book-card" inputmode="decimal" placeholder="22,00" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Preço de capa</span>
                <input id="book-cover-price" inputmode="decimal" placeholder="80,00" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Estoque</span>
                <input id="book-stock" type="number" min="0" step="1" value="0" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label>
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Estoque mínimo</span>
                <input id="book-min-stock" type="number" min="0" step="1" value="0" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              </label>
              <label class="md:col-span-2">
                <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Sinopse</span>
                <textarea id="book-synopsis" rows="4" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]"></textarea>
              </label>
              <div class="md:col-span-2 flex flex-wrap gap-5">
                <label class="flex items-center gap-2 text-xs font-bold text-gray-600 dark:text-gray-300">
                  <input id="book-active" type="checkbox" checked class="w-4 h-4 rounded border-gray-300 text-[var(--color-brand)]"> Ativo no catálogo
                </label>
                <label class="flex items-center gap-2 text-xs font-bold text-gray-600 dark:text-gray-300">
                  <input id="book-featured" type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[var(--color-brand)]"> Destaque
                </label>
              </div>
            </div>
          </div>

          <div id="book-feedback" class="hidden p-4 rounded-xl text-sm font-bold"></div>

          <div class="flex flex-col sm:flex-row gap-3 sm:justify-end pt-2">
            <button id="book-delete" type="button" class="hidden sm:mr-auto px-5 py-3 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-xs font-black uppercase tracking-widest hover:bg-red-100 transition-colors">
              <i class="fa-solid fa-trash-can mr-1"></i> Excluir
            </button>
            <button id="book-cancel" type="button" class="px-5 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 text-gray-500 text-xs font-black uppercase tracking-widest">Cancelar</button>
            <button id="book-save" type="submit" class="px-7 py-3 rounded-xl bg-[var(--color-brand)] text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-[var(--color-brand)]/20">
              Salvar livro
            </button>
          </div>
        </form>
      </div>
    </div>

  <div id="stock-modal" class="fixed inset-0 z-[3000] hidden bg-black/75 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="min-h-full flex items-center justify-center py-6">
      <div class="bg-white dark:bg-slate-800 w-full max-w-lg rounded-[2rem] shadow-2xl border border-white/10 p-6 md:p-8">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-[var(--color-brand)]">Estoque</p>
            <h2 id="stock-modal-title" class="text-2xl font-black text-gray-900 dark:text-white">Movimentar estoque</h2>
            <p id="stock-current" class="text-sm text-gray-500 mt-1"></p>
          </div>
          <button id="stock-close" type="button" aria-label="Fechar" class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-slate-900 text-gray-400 hover:text-red-500 shrink-0">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-4">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-red-700 dark:text-red-300 mb-2">Subtrair</p>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" class="stock-action-btn py-3 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 font-black" data-tipo="saida" data-qtd="1">−1</button>
              <button type="button" class="stock-action-btn py-3 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 font-black" data-tipo="saida" data-qtd="5">−5</button>
              <button type="button" class="stock-action-btn py-3 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 font-black" data-tipo="saida" data-qtd="10">−10</button>
            </div>
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-green-700 dark:text-green-300 mb-2">Adicionar</p>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" class="stock-action-btn py-3 rounded-xl bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-300 font-black" data-tipo="entrada" data-qtd="1">+1</button>
              <button type="button" class="stock-action-btn py-3 rounded-xl bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-300 font-black" data-tipo="entrada" data-qtd="5">+5</button>
              <button type="button" class="stock-action-btn py-3 rounded-xl bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-300 font-black" data-tipo="entrada" data-qtd="10">+10</button>
            </div>
          </div>
        </div>

        <label class="block mb-3">
          <span class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Motivo</span>
          <input id="stock-reason" type="text" placeholder="Ex: venda, doação, ajuste..." class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
        </label>

        <div id="stock-feedback" class="hidden p-3 rounded-xl text-sm font-bold mb-3"></div>
        <button id="stock-apply" type="button" class="w-full py-3 rounded-xl bg-[var(--color-brand)] text-white text-xs font-black uppercase tracking-widest mb-6">Aplicar movimentação</button>

        <div>
          <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2">Últimas movimentações</p>
          <div id="stock-history" class="space-y-1.5 text-xs text-gray-600 dark:text-gray-300 max-h-40 overflow-y-auto"></div>
        </div>
      </div>
    </div>
  </div>
</PortalLayout>

<script>
  import '../../scripts/portal/livraria.ts';
</script>
