---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Meu Perfil - Portal 1IPIM';
const description = 'Dados da conta e alteração de senha do Portal 1IPIM.';
---
<PortalLayout title={title} description={description}>
  <div class="mb-10">
    <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[var(--color-brand)] mb-2">Conta</p>
    <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight tracking-tighter uppercase">Meu perfil</h1>
    <p class="text-gray-500 mt-2">Seus dados de acesso ao Portal 1IPIM.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-4xl">
    <div class="bg-white dark:bg-slate-800 p-8 rounded-[2rem] border border-gray-100 dark:border-slate-700 shadow-sm">
      <h2 class="text-xl font-black text-gray-900 dark:text-white uppercase tracking-tighter mb-6">Dados da conta</h2>
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1">Nome</dt>
          <dd id="profile-name" class="font-bold text-gray-900 dark:text-white">—</dd>
        </div>
        <div>
          <dt class="text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1">E-mail</dt>
          <dd id="profile-email" class="font-bold text-gray-900 dark:text-white">—</dd>
        </div>
        <div>
          <dt class="text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1">Papel</dt>
          <dd id="profile-role" class="font-bold text-gray-900 dark:text-white">—</dd>
        </div>
      </dl>
    </div>

    <form id="password-form" class="bg-white dark:bg-slate-800 p-8 rounded-[2rem] border border-gray-100 dark:border-slate-700 shadow-sm space-y-4">
      <h2 class="text-xl font-black text-gray-900 dark:text-white uppercase tracking-tighter mb-2">Alterar senha</h2>
      <div>
        <label for="current-password" class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Senha atual</label>
        <input id="current-password" name="current_password" type="password" required autocomplete="current-password" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
      </div>
      <div>
        <label for="new-password" class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Nova senha</label>
        <input id="new-password" name="new_password" type="password" required minlength="8" autocomplete="new-password" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
      </div>
      <div>
        <label for="confirm-password" class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Confirmar nova senha</label>
        <input id="confirm-password" name="confirm_password" type="password" required minlength="8" autocomplete="new-password" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
      </div>
      <div id="password-feedback" class="hidden p-3 rounded-xl text-sm font-bold"></div>
      <button id="password-save" type="submit" class="w-full py-3 rounded-xl bg-[var(--color-brand)] text-white text-xs font-black uppercase tracking-widest">Salvar nova senha</button>
    </form>
  </div>
</PortalLayout>

<script>
  import '../../scripts/portal/perfil.ts';
</script>
