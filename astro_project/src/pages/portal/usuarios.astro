---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Gestão de Voluntários - 1IPIM';
const description = 'Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade.';
---
<PortalLayout title={title} description={description}>
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight tracking-tighter uppercase">Voluntários</h1>
      <p class="text-gray-500 mt-2">Aprove cadastros, defina papéis e organize os vínculos por ministério.</p>
    </div>
    <a href="/portal/novo-usuario" class="bg-[var(--color-brand)] hover:bg-[var(--color-brand-dark)] text-white px-8 py-4 rounded-2xl font-bold transition-all shadow-lg shadow-[var(--color-brand)]/20 flex items-center justify-center gap-2 text-sm uppercase shrink-0">
      <i class="fa-solid fa-user-plus"></i> Novo Voluntário
    </a>
  </div>

  <div id="users-stats" class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6"></div>

  <div class="bg-white dark:bg-slate-800 rounded-[2rem] border border-gray-100 dark:border-slate-700 p-5 md:p-6 shadow-sm mb-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
      <label class="relative md:col-span-2">
        <span class="sr-only">Buscar voluntários</span>
        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <input id="users-search" type="search" placeholder="Buscar por nome, usuário ou e-mail..." class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
      </label>
      <label class="sr-only" for="users-role">Filtrar por papel</label>
      <select id="users-role" class="px-4 py-3.5 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-bold text-gray-600 dark:text-gray-300 outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
        <option value="">Todos os papéis</option>
        <option value="administrator">Admin</option>
        <option value="pastor">Pastor</option>
        <option value="editor">Líder</option>
        <option value="lider_ministerio">Líder de ministério</option>
        <option value="contributor">Colaborador</option>
        <option value="colaborador_ministerio">Colaborador de ministério</option>
        <option value="subscriber">Membro</option>
        <option value="assinante">Assinante</option>
      </select>
      <label class="sr-only" for="users-ministry">Filtrar por ministério</label>
      <select id="users-ministry" class="px-4 py-3.5 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-bold text-gray-600 dark:text-gray-300 outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
        <option value="">Todos os ministérios</option>
      </select>
      <label class="flex items-center gap-2 text-xs font-bold text-gray-600 dark:text-gray-300 md:col-span-4">
        <input id="users-pending" type="checkbox" class="w-4 h-4 rounded border-gray-300 text-[var(--color-brand)]"> Mostrar apenas cadastros pendentes
      </label>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-[2.5rem] border border-gray-100 dark:border-slate-700 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[900px]">
        <thead>
          <tr class="border-b border-gray-100 dark:border-slate-700 font-medium h-20">
            <th class="px-8 text-[10px] font-black uppercase tracking-widest text-gray-500">Voluntário</th>
            <th class="px-8 text-[10px] font-black uppercase tracking-widest text-gray-500">Ministérios</th>
            <th class="px-8 text-[10px] font-black uppercase tracking-widest text-gray-500 text-center">Status</th>
            <th class="px-8 text-[10px] font-black uppercase tracking-widest text-gray-500 text-right">Ações</th>
          </tr>
        </thead>
        <tbody id="users-table-body"></tbody>
      </table>
    </div>
    <div id="loading-users" class="py-32 text-center">
      <div class="animate-spin inline-block w-10 h-10 border-[3px] border-current border-t-transparent text-[var(--color-brand)] rounded-full mb-4"></div>
      <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Sincronizando voluntários...</p>
    </div>
    <div id="no-users" class="hidden py-32 text-center">
      <i class="fa-solid fa-users-slash text-4xl text-gray-200 mb-4"></i>
      <p class="text-gray-500 font-bold">Nenhum voluntário encontrado.</p>
    </div>
    <div class="flex items-center justify-between gap-4 px-6 py-4 border-t border-gray-100 dark:border-slate-700">
      <p id="users-page-info" class="text-[11px] font-bold text-gray-500"></p>
      <div class="flex items-center gap-2">
        <button id="users-prev" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Anterior</button>
        <button id="users-next" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Próxima</button>
      </div>
    </div>
  </div>

  <div id="role-modal" class="fixed inset-0 z-[3000] hidden bg-black/75 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="min-h-full flex items-center justify-center py-6">
      <div class="bg-white dark:bg-slate-800 w-full max-w-lg rounded-[2rem] shadow-2xl border border-white/10 p-6 md:p-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-[var(--color-brand)]">Permissões</p>
            <h2 id="role-modal-title" class="text-2xl font-black text-gray-900 dark:text-white">Alterar papel</h2>
          </div>
          <button id="role-modal-close" type="button" aria-label="Fechar" class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-slate-900 text-gray-400 hover:text-red-500">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <div class="space-y-4">
          <div>
            <label for="role-select" class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2 ml-1">Papel global</label>
            <select id="role-select" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl text-sm font-bold text-gray-700 dark:text-gray-200 outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
              <option value="administrator">Administrador</option>
              <option value="pastor">Pastor</option>
              <option value="lider_ministerio">Líder de ministério</option>
              <option value="colaborador_ministerio">Colaborador de ministério</option>
              <option value="assinante">Assinante / Membro</option>
            </select>
          </div>
          <div id="role-ministry-field">
            <label for="role-ministry" class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2 ml-1">Ministério</label>
            <select id="role-ministry" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl text-sm font-bold text-gray-700 dark:text-gray-200 outline-none focus:ring-2 focus:ring-[var(--color-brand)]"></select>
          </div>
          <div id="role-feedback" class="hidden p-3 rounded-xl text-sm font-bold"></div>
          <div class="flex gap-3 pt-2">
            <button id="role-cancel" type="button" class="flex-1 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 text-gray-500 text-xs font-black uppercase tracking-widest">Cancelar</button>
            <button id="role-save" type="button" class="flex-1 py-3 rounded-xl bg-[var(--color-brand)] text-white text-xs font-black uppercase tracking-widest">Salvar papel</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</PortalLayout>

<script>
  import '../../scripts/portal/usuarios.ts';
</script>
