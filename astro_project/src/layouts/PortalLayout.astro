---
import Layout from './Layout.astro';
import '../styles/portal.css';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade."
} = Astro.props;
---
<Layout title={title} description={description} noindex={true} hideChrome={true}>
    <div class="flex h-screen bg-gray-50 dark:bg-slate-900 transition-colors overflow-hidden" id="portal-root">
        <!-- Auth Guard (Client Side) -->
        <div id="auth-guard" class="fixed inset-0 bg-white dark:bg-slate-900 z-[5000] flex items-center justify-center transition-opacity duration-500">
            <div class="flex flex-col items-center gap-4">
                <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-[var(--color-brand)]"></div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest animate-pulse">Autenticando...</p>
            </div>
        </div>

        <div class="lg:hidden fixed top-4 right-4 z-50">
            <button id="mobile-menu-btn" class="bg-white dark:bg-slate-800 p-3 rounded-xl shadow-lg border border-gray-100 dark:border-slate-700 text-gray-600 dark:text-gray-300">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
        </div>

        <!-- Sidebar -->
        <aside id="portal-sidebar" class="fixed lg:relative z-40 h-full w-64 lg:w-20 lg:hover:w-72 bg-white dark:bg-slate-800 border-r border-gray-100 dark:border-slate-700 transition-all duration-300 group overflow-x-hidden flex flex-col transform -translate-x-full lg:translate-x-0">
            <a href="/" class="p-6 flex items-center gap-4" title="Voltar ao site" aria-label="Voltar ao site principal">
                <div class="w-8 h-8 flex-shrink-0 bg-[var(--color-brand)] rounded-lg flex items-center justify-center text-white">
                    <i class="fa-solid fa-church"></i>
                </div>
                <span class="font-black text-gray-900 dark:text-white uppercase tracking-tighter opacity-100 lg:group-hover:opacity-100 lg:opacity-0 transition-opacity whitespace-nowrap overflow-hidden">Portal 1IPIM</span>
            </a>

            <nav class="flex-1 px-4 py-8 space-y-2 overflow-y-auto overflow-x-hidden">
                <a href="/portal" class="nav-link flex items-center gap-4 px-3 py-3 rounded-xl text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-700/50 hover:text-[var(--color-brand)] transition-all group/link overflow-hidden whitespace-nowrap">
                    <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center">
                        <i class="fa-solid fa-house"></i>
                    </div>
                    <span class="font-bold text-sm lg:opacity-100 lg:group-hover:opacity-100 opacity-0 transition-opacity">Painel Principal</span>
                </a>
                <div id="nav-dynamic-links" class="space-y-2"></div>
            </nav>

            <div class="mt-auto px-4 pb-4">
                <button id="portal-theme-toggle" class="nav-link w-full flex items-center gap-4 px-3 py-3 rounded-xl text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-700/50 hover:text-[var(--color-brand)] transition-all group/link overflow-hidden whitespace-nowrap mb-4">
                    <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center">
                        <i id="portal-theme-icon" class="fa-solid fa-moon"></i>
                    </div>
                    <span id="portal-theme-text" class="font-bold text-sm lg:opacity-100 lg:group-hover:opacity-100 opacity-0 transition-opacity">Modo Escuro</span>
                </button>
            </div>

            <div class="p-4 border-t border-gray-100 dark:border-slate-700">
                <div id="sidebar-user-info" class="flex items-center gap-3 px-2 py-3 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors overflow-hidden group/user">
                    <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-slate-700 flex-shrink-0 flex items-center justify-center text-gray-500 font-bold uppercase text-xs" id="user-initials">..</div>
                    <div class="flex-1 min-w-0 opacity-100 lg:group-hover:opacity-100 lg:opacity-0 transition-opacity">
                        <p class="text-xs font-bold text-gray-900 dark:text-white truncate" id="user-nav-name">Usuário</p>
                        <p class="text-[10px] text-gray-500 truncate" id="user-nav-role">Carregando...</p>
                    </div>
                    <button id="portal-logout-btn" class="text-gray-400 hover:text-red-500 p-2 opacity-100 lg:group-hover:opacity-100 lg:opacity-0 transition-opacity">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col h-full overflow-hidden relative">
            <div class="flex-1 overflow-y-auto pt-24 lg:pt-8 pb-12 px-4 lg:px-12">
                <div class="max-w-7xl mx-auto">
                    <slot />
                </div>
            </div>

            <div id="toast-container" class="fixed bottom-8 right-8 z-[6000] flex flex-col gap-4"></div>
        </main>
    </div>
</Layout>

<script>
    import '../scripts/portal/layout.js';
</script>
