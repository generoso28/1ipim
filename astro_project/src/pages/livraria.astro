---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/seo';

const title = 'Livraria 1IPIM - Livros e literatura cristã em Machado';
const description = 'Conheça o catálogo de livros da Livraria 1IPIM: literatura cristã, teologia, família, devocionais e muito mais. Consulte títulos, autores e preços.';

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Livraria 1IPIM",
  url: `${SITE.url}/livraria/`,
  isPartOf: { "@id": `${SITE.url}/#website` },
  about: { "@id": `${SITE.url}/#church` },
  description,
};
---
<Layout title={title} description={description} footerBgClass="bg-white dark:bg-slate-900" schema={collectionSchema}>
  <section class="pt-32 pb-16 bg-white dark:bg-slate-900 transition-colors min-h-screen">
    <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <p class="font-bold text-[var(--color-brand)] mb-3 uppercase tracking-[0.25em] text-xs">Livraria 1IPIM</p>
        <h1 class="font-black text-4xl md:text-6xl text-gray-900 dark:text-white mb-5 leading-tight tracking-tighter">Boas leituras para a caminhada</h1>
        <p class="text-gray-500 dark:text-gray-400 text-lg leading-relaxed">Literatura cristã, teologia, família e devocionais selecionados pelo ministério de Livraria da igreja.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-[2rem] border border-gray-100 dark:border-slate-700 p-5 md:p-6 shadow-sm max-w-4xl mx-auto mb-12">
        <div class="flex flex-col md:flex-row gap-3">
          <label class="flex-1 relative">
            <span class="sr-only">Buscar livros</span>
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input id="catalog-search" type="search" placeholder="Buscar por título, autor ou editora..." class="w-full pl-11 pr-4 py-4 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
          </label>
          <label for="catalog-category" class="sr-only">Filtrar por categoria</label>
          <select id="catalog-category" aria-label="Filtrar por categoria" class="md:w-64 px-4 py-4 rounded-2xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-bold text-gray-600 dark:text-gray-300 outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
            <option value="">Todas as categorias</option>
          </select>
        </div>
      </div>

      <div class="max-w-4xl mx-auto mb-10 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-2xl p-5 md:p-6 flex items-start gap-4">
        <i class="fa-solid fa-circle-info text-amber-600 dark:text-amber-400 text-xl mt-0.5"></i>
        <div class="text-sm text-amber-900 dark:text-amber-200 leading-relaxed space-y-1">
          <p><strong>Estoque e disponibilidade sob consulta.</strong> Fale com a secretaria da igreja durante a semana ou com a equipe da Livraria aos domingos.</p>
          <p>O catálogo pode não incluir todos os títulos disponíveis. Consulte a equipe para verificar outras opções.</p>
        </div>
      </div>

      <p id="catalog-count" class="sr-only" aria-live="polite"></p>

      <div id="catalog-loading" class="py-24 text-center">
        <div class="animate-spin inline-block w-10 h-10 border-[3px] border-current border-t-transparent text-[var(--color-brand)] rounded-full mb-4" role="status" aria-label="Carregando"></div>
        <p class="text-xs font-black text-gray-400 uppercase tracking-widest">Carregando catálogo...</p>
      </div>

      <div id="catalog-error" class="hidden bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-400 p-8 rounded-2xl text-center max-w-2xl mx-auto">
        <i class="fa-solid fa-circle-exclamation text-3xl mb-3"></i>
        <p class="font-bold">Não foi possível carregar o catálogo agora.</p>
        <p class="text-sm mt-1 text-amber-800 dark:text-amber-300">Tente novamente em instantes.</p>
      </div>

      <div id="catalog-empty" class="hidden py-24 text-center bg-gray-50/60 dark:bg-slate-800/30 rounded-[2rem] border-2 border-dashed border-gray-100 dark:border-slate-700">
        <i class="fa-solid fa-book-open text-5xl text-gray-200 mb-4"></i>
        <p class="text-gray-500 font-bold">Nenhum livro encontrado para esta busca.</p>
      </div>

      <div id="catalog-grid" class="hidden grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5 md:gap-8"></div>

      <div class="flex justify-center mt-12">
        <button id="catalog-more" type="button" class="hidden px-8 py-4 rounded-2xl bg-[var(--color-brand)] text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-[var(--color-brand)]/20 hover:bg-[var(--color-brand-dark)] transition-colors">Carregar mais livros</button>
      </div>
    </div>
  </section>

  <div id="book-detail-modal" class="fixed inset-0 z-[3000] hidden bg-black/80 backdrop-blur-md p-4 overflow-y-auto">
    <div class="min-h-full flex items-center justify-center py-6">
      <div class="bg-white dark:bg-slate-900 w-full max-w-3xl rounded-[2rem] shadow-2xl relative overflow-hidden">
        <button id="book-detail-close" type="button" aria-label="Fechar detalhes" class="absolute top-5 right-5 z-10 w-10 h-10 rounded-full bg-white/90 dark:bg-slate-800/90 text-gray-500 hover:text-red-500 transition-colors shadow-sm">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <div id="book-detail-content"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import '../scripts/livraria.ts';
</script>
