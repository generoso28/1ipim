# ==========================================================================
# 1IPIM — variáveis de build (prefixo `PUBLIC_` chega ao cliente)
# Copie para `.env` e ajuste por ambiente. Não comite o `.env`.
# ==========================================================================

# Base do WordPress (inclui `/admin`).
# Produção canônica: https://admin.1ipim.online/admin
PUBLIC_WP_ADMIN_BASE=https://admin.1ipim.online/admin

# Origem do site público (formulário de contato etc.).
PUBLIC_SITE_ORIGIN=https://1ipim.online

# Base do app Berea (app social).
# Se vazio, deriva de PUBLIC_WP_ADMIN_BASE + /wp-json/1ipim/v1
PUBLIC_BEREA_BASE=

# Origem do app Berea (frontend).
PUBLIC_BEREA_ORIGIN=https://berea.1ipim.online

# Origem da API do Berea (para requisições fetch).
PUBLIC_BEREA_API_BASE=https://admin.1ipim.online/admin/wp-json/1ipim/v1