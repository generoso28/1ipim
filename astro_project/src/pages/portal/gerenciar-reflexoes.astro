---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Gestão de Reflexões - 1IPIM';
const description = 'Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade.';
---
<PortalLayout title={title} description={description}>
  <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight tracking-tighter uppercase">Reflexões</h1>
      <p class="text-gray-500 mt-2">Gerencie as mensagens pastorais e boletins semanais.</p>
    </div>
    <a href="/portal/nova-reflexao" class="bg-[var(--color-brand)] hover:bg-[var(--color-brand-dark)] text-white px-8 py-4 rounded-2xl font-bold transition-all shadow-lg shadow-[var(--color-brand)]/20 flex items-center justify-center gap-2 text-sm uppercase shrink-0">
      <i class="fa-solid fa-plus"></i> Nova Reflexão
    </a>
  </div>

  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 border-b border-gray-100 dark:border-slate-700 pb-4">
    <div class="flex flex-wrap items-center gap-2">
      <button class="filter-tab active px-5 py-2.5 rounded-xl text-sm font-bold transition-all bg-[var(--color-brand)] text-white" data-filter="publish">Publicadas</button>
      <button class="filter-tab px-5 py-2.5 rounded-xl text-sm font-bold transition-all bg-white dark:bg-slate-800 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-700" data-filter="draft">Rascunhos</button>
      <button class="filter-tab px-5 py-2.5 rounded-xl text-sm font-bold transition-all bg-white dark:bg-slate-800 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-700" data-filter="trash"><i class="fa-solid fa-trash-can opacity-60 mr-1"></i> Lixeira</button>
    </div>
    <label class="relative lg:w-80">
      <span class="sr-only">Buscar reflexões</span>
      <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
      <input id="posts-search" type="search" placeholder="Buscar por título..." class="w-full pl-11 pr-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-sm font-medium text-gray-900 dark:text-white outline-none focus:ring-2 focus:ring-[var(--color-brand)]">
    </label>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-[2.5rem] border border-gray-100 dark:border-slate-700 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[760px]">
        <thead>
          <tr class="border-b border-gray-100 dark:border-slate-700 font-medium h-20">
            <th class="px-8 text-[10px] font-black uppercase tracking-widest text-gray-500">Título da Postagem</th>
            <th class="px-8 text-[10px] font-black uppercase tracking-widest text-gray-500 text-center">Publicado em</th>
            <th class="px-8 text-[10px] font-black uppercase tracking-widest text-gray-500 text-right">Ações</th>
          </tr>
        </thead>
        <tbody id="posts-table-body"></tbody>
      </table>
    </div>
    <div id="loading-posts" class="py-32 text-center">
      <div class="animate-spin inline-block w-10 h-10 border-[3px] border-current border-t-transparent text-[var(--color-brand)] rounded-full mb-4"></div>
      <p class="text-xs font-black text-gray-400 uppercase tracking-widest">Sincronizando com o site...</p>
    </div>
    <div id="no-posts" class="hidden py-32 text-center">
      <i class="fa-solid fa-folder-open text-4xl text-gray-200 mb-4"></i>
      <p class="text-gray-500 font-bold">Nenhuma reflexão encontrada.</p>
    </div>
    <div class="flex items-center justify-between gap-4 px-6 py-4 border-t border-gray-100 dark:border-slate-700">
      <p id="posts-page-info" class="text-[11px] font-bold text-gray-500"></p>
      <div class="flex items-center gap-2">
        <button id="posts-prev" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Anterior</button>
        <button id="posts-next" type="button" class="px-4 py-2 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 text-xs font-black uppercase text-gray-500 disabled:opacity-40">Próxima</button>
      </div>
    </div>
  </div>

  <div id="post-preview-modal" class="fixed inset-0 z-[3000] hidden bg-black/75 backdrop-blur-sm p-4 overflow-y-auto">
    <div class="min-h-full flex items-center justify-center py-6">
      <div class="bg-white dark:bg-slate-800 w-full max-w-3xl rounded-[2rem] shadow-2xl border border-white/10 p-6 md:p-10">
        <div class="flex items-start justify-between gap-4 mb-6">
          <h2 id="preview-title" class="text-2xl font-black text-gray-900 dark:text-white"></h2>
          <button id="preview-close" type="button" aria-label="Fechar" class="w-10 h-10 rounded-xl bg-gray-50 dark:bg-slate-900 text-gray-400 hover:text-red-500 shrink-0">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <div id="preview-content" class="prose dark:prose-invert max-w-none text-gray-700 dark:text-gray-300"></div>
      </div>
    </div>
  </div>
</PortalLayout>

<script>
  import '../../scripts/portal/gerenciar-reflexoes.ts';
</script>
