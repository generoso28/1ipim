---
import Layout from '../layouts/Layout.astro';
---
<Layout
    title="Página não encontrada - 1IPIM"
    description="A página que você procura não existe ou foi movida. Volte para a página inicial ou conheça a 1IPIM."
    noindex={true}
>
    <section class="min-h-[70vh] flex items-center justify-center px-4 pt-32 pb-20 bg-gray-50 dark:bg-slate-900 transition-colors">
        <div class="text-center max-w-2xl mx-auto scroll-card">
            <p class="text-[var(--color-brand)] font-black text-7xl md:text-9xl leading-none mb-4">404</p>
            <h1 class="font-extrabold text-3xl md:text-4xl text-gray-900 dark:text-white mb-6">Página não encontrada</h1>
            <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed mb-10">
                A página que você procura não existe ou foi movida. Que tal continuar por aqui?
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/" class="bg-[var(--color-brand)] text-white px-8 py-4 rounded-lg font-bold hover:bg-[var(--color-brand-dark)] transition-colors shadow-lg">
                    Voltar para o início
                </a>
                <a href="/visitantes" class="bg-white dark:bg-slate-800 text-gray-800 dark:text-white px-8 py-4 rounded-lg font-bold border border-gray-200 dark:border-slate-700 hover:border-[var(--color-brand)] transition-colors shadow-sm">
                    Primeira vez aqui?
                </a>
            </div>
        </div>
    </section>
</Layout>
