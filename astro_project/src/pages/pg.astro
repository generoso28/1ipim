---
import Layout from '../layouts/Layout.astro';
import { WP_REST_BASE } from '../config/api';

interface GrupoPublico {
    id: number;
    nome: string;
    publico_alvo: string;
    frequencia: string;
    dia_semana: number | null;
    horario: string;
    contato: string;
    responsavel: string;
    imagem: string;
}

const DIAS = ['', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado', 'Domingo'];

const esc = (value: unknown): string =>
    String(value ?? '').replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[ch] as string));

function cardHtml(g: GrupoPublico): string {
    const dia = g.dia_semana && DIAS[g.dia_semana] ? DIAS[g.dia_semana] : 'Dia a definir';
    const horario = g.horario ? ` às ${esc(g.horario)}` : '';
    const imagem = g.imagem
        ? `<img src="${esc(g.imagem)}" alt="${esc(g.nome)}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000 opacity-90 dark:opacity-70" loading="lazy" width="800" height="800" onerror="this.style.display='none'">`
        : '';
    const whats = g.contato || '5535988613046';
    const text = encodeURIComponent(`Olá, gostaria de saber mais sobre o Pequeno Grupo: ${g.nome}`);

    return `
        <div class="rounded-3xl border border-gray-200 dark:border-slate-700/50 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 overflow-hidden flex flex-col group relative min-h-[480px]">
            <div class="absolute inset-0 z-0 bg-gradient-to-br from-[#7ccece] to-[#7bcfa0]">
                ${imagem}
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-black/10"></div>
            </div>
            <div class="p-6 md:p-8 flex flex-col flex-1 relative z-10 justify-end">
                <h5 class="font-extrabold text-3xl text-white mb-6 drop-shadow-md">${esc(g.nome)}</h5>
                <div class="space-y-2 mt-auto bg-black/40 backdrop-blur-md rounded-2xl p-5 border border-white/10 group-hover:bg-black/50 transition-colors">
                    <p class="text-xs text-gray-300 flex justify-between border-b border-white/10 pb-2"><strong class="text-white uppercase tracking-wider text-[10px]">Público</strong> <span class="text-right">${esc(g.publico_alvo || 'Todos')}</span></p>
                    <p class="text-xs text-gray-300 flex justify-between border-b border-white/10 pb-2 pt-1"><strong class="text-white uppercase tracking-wider text-[10px]">Líder</strong> <span class="text-right">${esc(g.responsavel || '—')}</span></p>
                    <p class="text-xs text-gray-300 flex justify-between border-b border-white/10 pb-2 pt-1"><strong class="text-white uppercase tracking-wider text-[10px]">Horário</strong> <span class="text-right">${esc(dia)}${horario}</span></p>
                    <p class="text-xs text-gray-300 flex justify-between pt-1 mb-2 items-center"><strong class="text-white uppercase tracking-wider text-[10px]">Frequência</strong> <span class="bg-[var(--color-brand)] text-white px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide">${esc(g.frequencia || '—')}</span></p>
                    <a href="https://wa.me/${esc(whats)}?text=${text}" target="_blank" rel="nofollow" class="mt-4 block w-full text-center bg-white text-gray-900 py-3 rounded-xl font-bold hover:bg-gray-200 transition-colors text-sm shadow">
                        Tenho interesse
                    </a>
                </div>
            </div>
        </div>
    `;
}

// Busca no build para a lista já sair no HTML (SEO + fallback sem JS).
let grupos: GrupoPublico[] = [];
try {
    const response = await fetch(`${WP_REST_BASE}/grupos`, { headers: { Accept: 'application/json' } });
    if (response.ok) {
        grupos = (await response.json()) as GrupoPublico[];
    }
} catch {
    grupos = [];
}

const gridHtml = grupos.length
    ? grupos.map(cardHtml).join('')
    : `<p class="md:col-span-2 lg:col-span-3 text-center text-gray-500 py-12">Carregando grupos...</p>`;
---
<Layout title="Pequenos Grupos - Primeira Igreja Presbiteriana Independente de Machado" description="Pequenos Grupos da 1IPIM: encontros semanais em casas para estudar a Bíblia, orar e viver em comunidade. Encontre o grupo mais próximo." footerBgClass="bg-white dark:bg-slate-900">
    <section class="py-20 mt-16 bg-white dark:bg-slate-900 transition-colors min-h-screen">
        <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
            <div class="text-center max-w-2xl mx-auto mb-16 scroll-card">
                <h1 class="font-extrabold text-3xl md:text-4xl text-gray-900 dark:text-white mb-2">Nossos Pequenos Grupos</h1>
                <p class="text-gray-500 dark:text-gray-400 text-lg">A vida cristã é feita em comunidade. Encontre o grupo que mais se adequa ao seu momento.</p>
            </div>

            <div id="pg-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" set:html={gridHtml}></div>

            <div class="mt-20">
                <div class="text-center bg-gradient-to-br from-[#0f766e] to-[#0f7a34] text-white rounded-[2.5rem] md:rounded-[4rem] p-10 md:p-16 shadow-2xl max-w-5xl mx-auto scroll-card overflow-hidden relative group">
                    <div class="absolute -right-8 -bottom-8 text-black/10 text-[12rem] group-hover:scale-110 group-hover:rotate-12 transition-transform duration-700 pointer-events-none">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <div class="relative z-10 flex flex-col items-center">
                        <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mb-6 backdrop-blur shadow-sm group-hover:scale-110 transition-transform">
                            <i class="fa-brands fa-whatsapp text-4xl"></i>
                        </div>
                        <h4 class="font-extrabold text-3xl md:text-5xl mb-6 leading-tight">Quer saber mais?</h4>
                        <p class="text-white/90 mb-10 max-w-2xl mx-auto text-lg leading-relaxed font-medium">Não importa sua idade ou onde você mora, sempre tem um grupo esperando de braços abertos. Fale com nossa secretaria e encontre o seu lugar.</p>
                        <a href="https://wa.me/5535988613046" target="_blank" rel="nofollow" class="inline-flex items-center gap-3 bg-white text-[#0f6f63] px-10 py-5 rounded-full font-extrabold hover:scale-105 transition-transform shadow-xl">
                            Chamar no WhatsApp <i class="fa-solid fa-arrow-right text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    import { WP_REST_BASE } from '../config/api';

    const DIAS = ['', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado', 'Domingo'];

    interface GrupoPublico {
        id: number;
        nome: string;
        publico_alvo: string;
        frequencia: string;
        dia_semana: number | null;
        horario: string;
        contato: string;
        responsavel: string;
        imagem: string;
    }

    const esc = (value: unknown): string =>
        String(value ?? '').replace(/[&<>"']/g, (ch) => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[ch] as string));

    function card(g: GrupoPublico): string {
        const dia = g.dia_semana && DIAS[g.dia_semana] ? DIAS[g.dia_semana] : 'Dia a definir';
        const horario = g.horario ? ` às ${esc(g.horario)}` : '';
        const imagem = g.imagem
            ? `<img src="${esc(g.imagem)}" alt="${esc(g.nome)}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000 opacity-90 dark:opacity-70" loading="lazy" width="800" height="800" onerror="this.style.display='none'">`
            : '';
        const whats = g.contato || '5535988613046';
        const text = encodeURIComponent(`Olá, gostaria de saber mais sobre o Pequeno Grupo: ${g.nome}`);

        return `
            <div class="rounded-3xl border border-gray-200 dark:border-slate-700/50 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 overflow-hidden flex flex-col group relative min-h-[480px]">
                <div class="absolute inset-0 z-0 bg-gradient-to-br from-[#7ccece] to-[#7bcfa0]">
                    ${imagem}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-black/10"></div>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-1 relative z-10 justify-end">
                    <h5 class="font-extrabold text-3xl text-white mb-6 drop-shadow-md">${esc(g.nome)}</h5>
                    <div class="space-y-2 mt-auto bg-black/40 backdrop-blur-md rounded-2xl p-5 border border-white/10 group-hover:bg-black/50 transition-colors">
                        <p class="text-xs text-gray-300 flex justify-between border-b border-white/10 pb-2"><strong class="text-white uppercase tracking-wider text-[10px]">Público</strong> <span class="text-right">${esc(g.publico_alvo || 'Todos')}</span></p>
                        <p class="text-xs text-gray-300 flex justify-between border-b border-white/10 pb-2 pt-1"><strong class="text-white uppercase tracking-wider text-[10px]">Líder</strong> <span class="text-right">${esc(g.responsavel || '—')}</span></p>
                        <p class="text-xs text-gray-300 flex justify-between border-b border-white/10 pb-2 pt-1"><strong class="text-white uppercase tracking-wider text-[10px]">Horário</strong> <span class="text-right">${esc(dia)}${horario}</span></p>
                        <p class="text-xs text-gray-300 flex justify-between pt-1 mb-2 items-center"><strong class="text-white uppercase tracking-wider text-[10px]">Frequência</strong> <span class="bg-[var(--color-brand)] text-white px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide">${esc(g.frequencia || '—')}</span></p>
                        <a href="https://wa.me/${esc(whats)}?text=${text}" target="_blank" rel="nofollow" class="mt-4 block w-full text-center bg-white text-gray-900 py-3 rounded-xl font-bold hover:bg-gray-200 transition-colors text-sm shadow">
                            Tenho interesse
                        </a>
                    </div>
                </div>
            </div>
        `;
    }

    async function refresh(): Promise<void> {
        const grid = document.getElementById('pg-grid');
        if (!grid) return;
        try {
            const response = await fetch(`${WP_REST_BASE}/grupos`, { headers: { Accept: 'application/json' } });
            if (!response.ok) return;
            const groups = (await response.json()) as GrupoPublico[];
            if (Array.isArray(groups) && groups.length > 0) {
                grid.innerHTML = groups.map(card).join('');
            }
        } catch {
            // Mantém a lista renderizada no build.
        }
    }

    refresh();
</script>
