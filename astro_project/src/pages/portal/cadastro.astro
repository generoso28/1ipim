---
import Layout from '../../layouts/Layout.astro';

const title = 'Cadastro de Voluntário - 1IPIM';
const description = 'Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade.';
---
<Layout title={title} description={description} noindex={true}>
    <script is:inline>if (localStorage.getItem('1ipim_auth_nonce')) {
            window.location.href = '/portal';
        }</script>
<section class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-slate-900 px-4 py-12 transition-colors"> <div class="max-w-md w-full bg-white dark:bg-slate-800 rounded-[2rem] shadow-2xl overflow-hidden border border-gray-100 dark:border-slate-700 p-8 md:p-10"> <div class="text-center mb-8"> <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-500/10 text-blue-500 rounded-2xl mb-4"> <i class="fa-solid fa-user-plus text-2xl"></i> </div> <h1 class="text-2xl font-black text-gray-900 dark:text-white mb-2 tracking-tighter uppercase">Solicitar Acesso</h1> <p class="text-gray-500 dark:text-gray-400 text-sm">Crie sua conta para se voluntariar nos ministérios.</p> </div> <form id="register-form" class="space-y-5"> <div> <label for="reg-name" class="block text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2 ml-1">Nome Completo</label> <input type="text" id="reg-name" name="name" required class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent transition-all outline-none" placeholder="João Silva"> </div> <div> <label for="reg-user" class="block text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2 ml-1">Nome de Usuário (Login)</label> <input type="text" id="reg-user" name="username" required class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent transition-all outline-none" placeholder="joao_silva"> </div> <div> <label for="reg-email" class="block text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2 ml-1">E-mail</label> <input type="email" id="reg-email" name="email" required class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent transition-all outline-none" placeholder="seu@email.com"> </div> <div> <label for="reg-pass" class="block text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2 ml-1">Senha</label> <input type="password" id="reg-pass" name="password" required class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent transition-all outline-none" placeholder="••••••••"> </div> <div> <label class="block text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-2 ml-1">Quais ministérios deseja participar?</label> <div id="ministries-grid" class="grid grid-cols-2 gap-3 bg-gray-50 dark:bg-slate-900/50 p-4 rounded-xl border border-gray-200 dark:border-slate-700 max-h-40 overflow-y-auto"> <p class="text-[10px] text-gray-400 col-span-2">Carregando áreas...</p> </div> </div> <div id="reg-feedback" class="hidden p-4 rounded-xl text-sm flex items-start gap-3 transition-all"> <i id="feedback-icon" class="fa-solid mt-0.5"></i> <p id="feedback-message"></p> </div> <button type="submit" id="reg-submit-btn" class="w-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold py-4 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 group mt-2"> <span id="reg-btn-text">Criar minha conta</span> <i id="reg-btn-loader" class="fa-solid fa-circle-notch animate-spin hidden"></i> </button> </form> <div class="mt-8 pt-8 border-t border-gray-100 dark:border-slate-700 text-center"> <a href="/portal/login" class="text-gray-500 dark:text-gray-400 text-sm hover:text-[var(--color-brand)] transition-colors font-bold"> <i class="fa-solid fa-arrow-left text-xs mr-1"></i> Voltar para o Login
</a> </div> </div> </section>
</Layout>

<script is:inline>
if (localStorage.getItem('1ipim_auth_nonce')) {
            window.location.href = '/portal';
        }
</script>

<script>
import '../../scripts/portal/cadastro.ts';
</script>
