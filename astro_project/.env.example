# ==========================================================================
# 1IPIM — variáveis de build (prefixo `PUBLIC_` chega ao cliente)
# Copie para `.env` e ajuste por ambiente. Não comite o `.env`.
# ==========================================================================

# Base do WordPress. Produção atual inclui `/admin`.
# Na migração para subdomínios, use: https://admin.1ipim.online
PUBLIC_WP_ADMIN_BASE=https://1ipim.online/admin

# Origem do site público (formulário de contato etc.).
PUBLIC_SITE_ORIGIN=https://1ipim.online
