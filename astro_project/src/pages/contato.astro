---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/seo';

const congregacoes = [
    { name: "Santa Luíza", address: "R. Ituiutaba, 58", city: "Santa Luiza, Machado-MG" },
    { name: "Jardim das Oliveiras", address: "R. Augusto Buzatti Filho, 204", city: "Jd. das Oliveiras, Machado-MG" },
    { name: "Santo Antônio II", address: "R. José Cândido de Souza Dias,", city: "Santo Antônio II, Machado-MG" },
    { name: "Serrania", address: "R. Cel. Antônio Faustino, 450", city: "Serrania-MG" },
    { name: "Paraguaçu", address: "Av. Dr. Domingos Condé, 70", city: "Parque dos Pinheiros, Paraguaçu-MG" },
    { name: "Carvalhópolis", address: "R. Marcolino Pereira de Carvalho, 385", city: "Carvalhópolis-MG" },
    { name: "Pouso Alegre", address: "R. Coronel José Inacio, 290", city: "Jardim Noronha, Pouso Alegre-MG" }
];

const contactSchema = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contato — 1IPIM",
    url: `${SITE.url}/contato/`,
    mainEntity: { "@id": `${SITE.url}/#church` },
};
---
<Layout title="Contato - Primeira Igreja Presbiteriana Independente de Machado" description="Fale com a 1IPIM: endereço da sede e das congregações em Machado (MG), telefone, e-mail e mapa para chegar até nós." footerBgClass="bg-white dark:bg-slate-900" schema={contactSchema}>
    <section class="py-20 mt-16 bg-white dark:bg-slate-900 transition-colors min-h-screen">
        <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
            <div class="text-center max-w-2xl mx-auto mb-16 scroll-card">
                <p class="font-bold text-[var(--color-success)] mb-2 uppercase tracking-wide text-sm">Contato</p>
                <h1 class="font-extrabold text-3xl md:text-4xl text-gray-900 dark:text-white mb-2">Saiba como entrar em contato</h1>
                <p class="text-gray-500 dark:text-gray-400">Sede em Machado (MG) e congregações na região.</p>
            </div>

            <div class="flex flex-col lg:flex-row gap-8 mb-16">
                <!-- Sede Contact Info -->
                <div class="w-full lg:w-1/3 bg-white dark:bg-slate-800 rounded-[2.5rem] p-10 lg:p-12 border border-gray-100 dark:border-slate-700 shadow-xl scroll-card flex flex-col relative overflow-hidden group">
                    <div class="absolute right-0 top-0 w-64 h-64 bg-[var(--color-success)]/10 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/2 pointer-events-none group-hover:scale-150 transition-transform duration-1000"></div>
                    <div class="relative z-10 flex-1">
                        <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white mb-10">Sede</h2>
                        
                        <div class="space-y-10">
                            <div class="flex items-start gap-5">
                                <div class="w-14 h-14 rounded-2xl bg-[var(--color-success)]/10 dark:bg-[var(--color-success)]/20 text-[var(--color-success)] dark:text-[var(--color-success-light)] flex items-center justify-center shrink-0 shadow-sm group-hover:scale-110 transition-transform">
                                    <i class="fa-solid fa-phone text-xl"></i>
                                </div>
                                <div>
                                    <h6 class="font-bold text-gray-900 dark:text-gray-100 mb-1 text-sm uppercase tracking-wide">Telefone</h6>
                                    <p class="text-gray-600 dark:text-gray-300 m-0 leading-relaxed">(35) 98861-3046</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-5">
                                <div class="w-14 h-14 rounded-2xl bg-[var(--color-success)]/10 dark:bg-[var(--color-success)]/20 text-[var(--color-success)] dark:text-[var(--color-success-light)] flex items-center justify-center shrink-0 shadow-sm group-hover:scale-110 transition-transform">
                                    <i class="fa-solid fa-envelope text-xl"></i>
                                </div>
                                <div>
                                    <h6 class="font-bold text-gray-900 dark:text-gray-100 mb-1 text-sm uppercase tracking-wide">Email</h6>
                                    <p class="text-gray-600 dark:text-gray-300 m-0"><a href="mailto:secretaria1ipi@gmail.com" class="hover:text-[var(--color-success)] transition-colors">secretaria1ipi@gmail.com</a></p>
                                </div>
                            </div>

                            <div class="flex items-start gap-5">
                                <div class="w-14 h-14 rounded-2xl bg-[var(--color-success)]/10 dark:bg-[var(--color-success)]/20 text-[var(--color-success)] dark:text-[var(--color-success-light)] flex items-center justify-center shrink-0 shadow-sm group-hover:scale-110 transition-transform">
                                    <i class="fa-solid fa-location-dot text-xl"></i>
                                </div>
                                <div>
                                    <h6 class="font-bold text-gray-900 dark:text-gray-100 mb-1 text-sm uppercase tracking-wide">Endereço</h6>
                                    <p class="text-gray-600 dark:text-gray-300 m-0 leading-relaxed">R. Airton Rodrigues Leite, 26 - Centro<br/>Machado, MG</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Google Maps -->
                <div id="map-container" class="w-full lg:w-2/3 h-[450px] lg:h-auto min-h-[450px] rounded-[2.5rem] overflow-hidden shadow-xl border border-gray-100 dark:border-slate-700 scroll-card relative bg-gray-50 dark:bg-slate-800">
                    <div id="map-placeholder" class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center bg-[radial-gradient(circle_at_30%_20%,var(--color-success)_0%,transparent_45%)] dark:bg-[radial-gradient(circle_at_30%_20%,#0f3d33_0%,transparent_45%)]">
                        <i class="fa-solid fa-map-location-dot text-5xl text-[var(--color-success)] mb-4"></i>
                        <p class="font-bold text-gray-900 dark:text-white mb-1">Rua Airton Rodrigues Leite, 26</p>
                        <p class="text-sm text-gray-600 dark:text-gray-300 mb-5">Centro, Machado/MG</p>
                        <button type="button" id="map-load" class="inline-flex items-center gap-2 bg-[var(--color-success)] text-white px-6 py-3 rounded-xl font-bold hover:brightness-110 transition-all">
                            <i class="fa-solid fa-map"></i> Ver mapa interativo
                        </button>
                        <a href="https://maps.google.com/?q=Rua+Airton+Rodrigues+Leite,+26,+Machado,+MG" target="_blank" rel="nofollow" class="mt-3 text-xs font-bold text-[var(--color-success)] underline">Abrir no Google Maps</a>
                    </div>
                    <noscript>
                        <style>#map-placeholder{display:none}</style>
                        <iframe title="Mapa de localização" class="w-full h-full" src="https://maps.google.com/maps?width=100%25&amp;height=100%25&amp;hl=en&amp;q=Rua%20Airton%20Rodrigues%20Leite,%2026&amp;t=&amp;z=17&amp;ie=UTF8&amp;iwloc=B&amp;output=embed"></iframe>
                    </noscript>
                </div>
            </div>

            <div class="mt-16">
                <div class="bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 md:p-12 border border-gray-100 dark:border-slate-700 shadow-xl relative overflow-hidden">
                    <div class="absolute right-0 top-0 w-72 h-72 bg-[var(--color-success)]/10 rounded-full blur-[90px] -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
                    <div class="relative z-10 max-w-2xl mb-8">
                        <p class="font-bold text-[var(--color-success)] mb-2 uppercase tracking-wide text-sm">Envie uma mensagem</p>
                        <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white mb-3">Fale com a secretaria</h2>
                        <p class="text-gray-500 dark:text-gray-400">Preencha os campos abaixo e responderemos pelo e-mail informado. Se preferir, ligue para (35) 98861-3046.</p>
                    </div>

                    <form id="contact-form" class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label for="contact-name" class="block text-xs font-bold uppercase tracking-widest text-gray-600 dark:text-gray-300 mb-2 ml-1">Nome</label>
                            <input type="text" id="contact-name" name="name" required minlength="2" maxlength="120" autocomplete="name" placeholder="Seu nome completo" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-success)] focus:border-transparent transition-all outline-none" />
                        </div>

                        <div>
                            <label for="contact-email" class="block text-xs font-bold uppercase tracking-widest text-gray-600 dark:text-gray-300 mb-2 ml-1">E-mail</label>
                            <input type="email" id="contact-email" name="email" required maxlength="160" autocomplete="email" placeholder="voce@email.com" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-success)] focus:border-transparent transition-all outline-none" />
                        </div>

                        <div>
                            <label for="contact-phone" class="block text-xs font-bold uppercase tracking-widest text-gray-600 dark:text-gray-300 mb-2 ml-1">Telefone <span class="normal-case font-medium tracking-normal text-gray-500 dark:text-gray-400">(opcional)</span></label>
                            <input type="tel" id="contact-phone" name="phone" maxlength="40" autocomplete="tel" placeholder="(35) 99999-9999" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-success)] focus:border-transparent transition-all outline-none" />
                        </div>

                        <div>
                            <label for="contact-subject" class="block text-xs font-bold uppercase tracking-widest text-gray-600 dark:text-gray-300 mb-2 ml-1">Assunto</label>
                            <select id="contact-subject" name="subject" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-success)] focus:border-transparent transition-all outline-none">
                                <option value="Contato">Contato geral</option>
                                <option value="Visita">Gostaria de visitar a igreja</option>
                                <option value="Oracao">Pedido de oração</option>
                                <option value="Voluntariado">Quero ser voluntário</option>
                            </select>
                        </div>

                        <div class="md:col-span-2">
                            <label for="contact-message" class="block text-xs font-bold uppercase tracking-widest text-gray-600 dark:text-gray-300 mb-2 ml-1">Mensagem</label>
                            <textarea id="contact-message" name="message" required minlength="10" maxlength="5000" rows="5" placeholder="Escreva sua mensagem..." class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-[var(--color-success)] focus:border-transparent transition-all outline-none resize-y"></textarea>
                        </div>

                        <div class="absolute -left-[9999px] top-auto" aria-hidden="true">
                            <label for="contact-website">Website</label>
                            <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
                        </div>

                        <div id="contact-feedback" class="hidden md:col-span-2 p-4 rounded-xl text-sm flex items-start gap-3" role="status" aria-live="polite">
                            <i id="contact-feedback-icon" class="fa-solid mt-0.5"></i>
                            <p id="contact-feedback-message"></p>
                        </div>

                        <button type="submit" id="contact-submit" class="md:col-span-2 w-full bg-[var(--color-success)] hover:brightness-110 text-white font-bold py-4 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed">
                            <span id="contact-btn-text">Enviar mensagem</span>
                            <i id="contact-btn-loader" class="fa-solid fa-circle-notch animate-spin hidden"></i>
                        </button>

                        <p class="md:col-span-2 text-[11px] leading-relaxed text-gray-500 dark:text-gray-400">Seus dados são usados apenas para responder a este contato e não são compartilhados.</p>
                    </form>
                </div>
            </div>

            <div class="mt-16">
                <h3 class="font-extrabold text-3xl text-gray-900 dark:text-white mb-10 text-center scroll-card">Nossas Congregações</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
                    {congregacoes.map(cong => (
                        <div class="bg-gray-50 dark:bg-slate-800 rounded-[2rem] p-8 border border-gray-100 dark:border-slate-700 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all scroll-card flex flex-col h-full group relative overflow-hidden">
                            <div class="absolute -right-4 -bottom-4 text-[var(--color-success)]/5 text-7xl group-hover:scale-125 transition-transform duration-500 pointer-events-none">
                                <i class="fa-solid fa-church"></i>
                            </div>
                            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 group-hover:text-[var(--color-success)] transition-colors relative z-10">{cong.name}</h2>
                            <div class="mt-auto relative z-10">
                                <h6 class="font-bold text-[var(--color-success)] text-[10px] mb-1 uppercase tracking-widest">Endereço</h6>
                                <p class="text-gray-600 dark:text-gray-400 text-sm mb-0 leading-relaxed">{cong.address}<br/>{cong.city}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

        </div>
    </section>
<script>
import '../scripts/contato.ts';
</script>
</Layout>
