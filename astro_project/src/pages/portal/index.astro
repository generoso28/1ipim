---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Painel Administrativo - 1IPIM';
const description = 'Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade.';
---
<PortalLayout title={title} description={description}>
  <div class="mb-12" data-astro-cid-4d3t45dq> <p class="text-[var(--color-brand)] font-bold uppercase tracking-widest text-xs mb-2" data-astro-cid-4d3t45dq>Resumo da sua conta</p> <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight" data-astro-cid-4d3t45dq>Olá, <span id="dash-user-name" data-astro-cid-4d3t45dq>...</span>!</h1> <p class="text-gray-500 mt-2" data-astro-cid-4d3t45dq>Bem-vindo ao centro de operações da sua igreja.</p> </div> <div id="dashboard-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-astro-cid-4d3t45dq> <!-- Cards serão injetados via JS --> </div>  
</PortalLayout>

<script>
import '../../scripts/portal/dashboard.ts';
</script>
