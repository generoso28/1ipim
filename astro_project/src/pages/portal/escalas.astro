---
import PortalLayout from '../../layouts/PortalLayout.astro';

const title = 'Gerenciar Escalas - 1IPIM';
const description = 'Igreja Presbiteriana Independente de Machado – Há 150 anos servindo a Deus e à comunidade.';
---
<PortalLayout title={title} description={description}>
  <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6"> <div> <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight tracking-tighter uppercase" id="page-title">Escalas</h1> <p class="text-gray-500 mt-2" id="page-subtitle">Organize os voluntários para os próximos cultos e eventos.</p> </div> <!-- Filtro: Todas / Minhas --> <div class="flex flex-col sm:flex-row items-center gap-3"> <div class="flex items-center gap-1 bg-white dark:bg-slate-800 p-1.5 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700"> <button class="filter-tab active px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest bg-[var(--color-brand)] text-white shadow-lg shadow-[var(--color-brand)]/20 transition-all" data-filter="all">
Todas
</button> <button class="filter-tab px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest text-gray-500 hover:bg-gray-50 dark:hover:bg-slate-700 transition-all" data-filter="mine">
Minhas
</button> </div> <div class="flex items-center gap-1 bg-gray-100/50 dark:bg-slate-800/50 p-1.5 rounded-2xl border border-gray-100 dark:border-slate-700"> <button class="view-toggle active px-4 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-700 text-gray-900 dark:text-white shadow-sm transition-all" data-view="list"> <i class="fa-solid fa-list mr-1"></i> Lista
</button> <button class="view-toggle px-4 py-2 rounded-xl text-xs font-bold text-gray-500 hover:text-gray-900 dark:hover:text-white transition-all" data-view="calendar"> <i class="fa-regular fa-calendar mr-1"></i> Calendário
</button> </div> </div> </div> <div class="grid grid-cols-1 lg:grid-cols-12 gap-8"> <!-- Form: Cadastro (Apenas para Admin/Líder) --> <div class="lg:col-span-4" id="form-container"> <div class="bg-white dark:bg-slate-800 p-8 rounded-[2.5rem] border border-gray-100 dark:border-slate-700 shadow-sm sticky top-8"> <h3 class="text-xl font-black text-gray-900 dark:text-white mb-6 uppercase tracking-tighter">Nova Escala</h3> <form id="add-scale-form" class="space-y-5"> <div> <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2 ml-1">Para qual Ministério?</label> <select id="scale-ministry" required class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl outline-none font-bold text-sm"> <option value="">Selecione...</option> </select> </div> <div> <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2 ml-1">O que teremos?</label> <input type="text" id="scale-title" required class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl outline-none text-sm font-bold" placeholder="Ex: Culto de Celebração"> </div> <div class="grid grid-cols-2 gap-4"> <div> <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2 ml-1">Data</label> <input type="date" id="scale-date" required class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl outline-none text-sm font-bold"> </div> <div> <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2 ml-1">Hora</label> <input type="time" id="scale-time" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl outline-none text-sm font-bold"> </div> </div> <div> <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2 ml-1">Equipe Escalada</label> <div id="volunteers-select" class="bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl max-h-48 overflow-y-auto p-4 space-y-2"> <!-- Injetado via JS --> <p class="text-[10px] text-gray-400 text-center animate-pulse">Carregando...</p> </div> </div> <div> <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2 ml-1">Recorrência Semanal</label> <select id="scale-recurrence" class="block w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-xl outline-none font-bold text-sm"> <option value="1">Apenas nesta data</option> <option value="2">Repetir por 2 Semanas</option> <option value="3">Repetir por 3 Semanas</option> <option value="4">Repetir por 4 Semanas (1 Mês)</option> <option value="8">Repetir por 8 Semanas (2 Meses)</option> </select> </div> <button type="submit" id="scale-add-btn" class="w-full bg-[var(--color-brand)] text-white font-black py-4 rounded-2xl shadow-lg shadow-[var(--color-brand)]/20 transition-all flex items-center justify-center gap-2 uppercase text-sm"> <span id="scale-add-text">Agendar Escala</span> <i id="scale-add-loader" class="fa-solid fa-circle-notch animate-spin hidden"></i> </button> </form> </div> </div> <!-- List & Calendar: Visualização --> <div class="lg:col-span-8 space-y-4" id="list-container"> <div id="list-view" class="space-y-4"> <div id="loading-scales" class="py-32 text-center"> <div class="animate-spin inline-block w-10 h-10 border-[3px] border-current border-t-transparent text-[var(--color-brand)] rounded-full mb-4"></div> <p class="text-xs font-black text-gray-400 uppercase tracking-widest">Sincronizando agendas...</p> </div> </div> <div id="calendar-view" class="hidden bg-white dark:bg-slate-800 p-6 rounded-[2.5rem] border border-gray-100 dark:border-slate-700 shadow-sm animate-slide-up"> <!-- Injetar via JS --> </div> </div> </div>  <div id="scale-modal" class="fixed inset-0 z-[10000] hidden flex items-center justify-center p-4 sm:p-6 bg-black/60 backdrop-blur-sm transition-all"> <div class="bg-white dark:bg-slate-800 w-full max-w-2xl rounded-[2.5rem] border border-gray-100 dark:border-slate-700 shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"> <div class="p-6 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-900/50"> <div id="modal-title-area"> <h3 id="modal-title" class="text-xl font-black text-gray-900 dark:text-white uppercase tracking-tighter">Scales</h3> </div> <button id="close-modal" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-slate-700 text-gray-400 hover:text-red-500 transition-all border border-gray-100 dark:border-slate-600"> <i class="fa-solid fa-xmark"></i> </button> </div> <div id="modal-content" class="p-6 overflow-y-auto flex-1 space-y-4"> <!-- Injetado via JS --> </div> </div> </div>  
</PortalLayout>

<script>
import '../../scripts/portal/escalas.ts';
</script>
