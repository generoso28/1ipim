---
import { Image } from 'astro:assets';
import logoImage from '../assets/img/logo_transp.png';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
    href === '/' ? currentPath === '/' : currentPath === href.replace(/\/+$/, '');

const primaryLinks = [
    { href: "/", text: "Home" },
    { href: "/mensagens", text: "Mensagens" },
    { href: "/livraria", text: "Livraria" },
    { href: "/pg", text: "Pequenos Grupos" }
];

const dropdowns = [
    {
        label: "Agenda",
        links: [
            { href: "/programacao", text: "Programação" },
            { href: "/eventos", text: "Eventos" },
            { href: "/semana-jovem", text: "Semana Jovem" }
        ]
    },
    {
        label: "A Igreja",
        links: [
            { href: "/pastores", text: "Pastores" },
            { href: "/cremos", text: "O que cremos?" },
            { href: "/historia", text: "Nossa história" }
        ]
    }
];

const visitLink = { href: "/visitantes", text: "Primeira Vez?" };
const { isImmersive = false } = Astro.props || {};
---
<nav class={`fixed top-0 left-0 w-full z-[1000] transition-all duration-700 pt-3 md:pt-5 px-4 pointer-events-none ${isImmersive ? 'opacity-0 -translate-y-[150%] is-immersive' : ''}`} id="mainNav">
    <div class="container mx-auto px-6 py-3 flex justify-between items-center max-w-7xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-lg rounded-2xl xl:rounded-full shadow-lg border border-white/50 dark:border-slate-700/50 pointer-events-auto transition-colors">
        <a class="flex justify-center items-center shrink-0" href="/">
            <Image alt="Logo da igreja" class="max-w-[40px] h-auto hover:scale-105 transition-transform drop-shadow-sm" src={logoImage} width={40} height={40} loading="eager" />
        </a>

        <div class="flex items-center space-x-2 md:space-x-6 lg:space-x-8">
            <div class="hidden xl:flex items-center space-x-6">
                {primaryLinks.map(link => (
                    <a
                        href={link.href}
                        class={`font-medium transition-colors hover:text-[var(--color-brand)] dark:hover:text-[var(--color-brand-light)] text-sm ${isActive(link.href) ? 'text-[var(--color-brand)] dark:text-[var(--color-brand-light)]' : 'text-gray-600 dark:text-gray-300'}`}
                    >
                        {link.text}
                    </a>
                ))}

                {dropdowns.map(group => (
                    <div class="relative group h-full py-2">
                        <button type="button" aria-haspopup="true" class="flex items-center gap-1.5 font-medium text-gray-600 dark:text-gray-300 transition-colors hover:text-[var(--color-brand)] dark:hover:text-[var(--color-brand-light)] text-sm focus:outline-none">
                            {group.label} <i class="fa-solid fa-chevron-down text-[10px] transition-transform group-hover:rotate-180"></i>
                        </button>
                        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-4 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-300 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
                            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-gray-100 dark:border-slate-700 p-2 min-w-[200px] backdrop-blur-xl">
                                {group.links.map(link => (
                                    <a
                                        href={link.href}
                                        class={`block px-4 py-2.5 rounded-xl text-sm transition-all hover:bg-gray-50 dark:hover:bg-slate-700/50 hover:pl-5 ${isActive(link.href) ? 'text-[var(--color-brand)] dark:text-[var(--color-brand-light)]' : 'text-gray-600 dark:text-gray-300'}`}
                                    >
                                        {link.text}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                ))}

                <a href={visitLink.href} class="bg-[var(--color-brand)] text-white px-5 py-2.5 rounded-lg font-bold hover:bg-[var(--color-brand-dark)] transition-colors shadow-md animate-pulse hover:animate-none flex items-center gap-2 ml-4">
                    <i class="fa-solid fa-hand-wave"></i> {visitLink.text}
                </a>
            </div>

            <button id="theme-toggle" type="button" aria-label="Alternar tema" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-slate-800 focus:outline-none rounded-lg text-sm p-2 transition-colors">
                <i id="theme-toggle-dark-icon" class="fa-solid fa-moon hidden text-lg"></i>
                <i id="theme-toggle-light-icon" class="fa-solid fa-sun hidden text-lg"></i>
            </button>

            <div class="xl:hidden flex">
                <button id="mobile-menu-btn" aria-label="Menu" class="p-2 text-gray-600 dark:text-gray-300 hover:text-[var(--color-brand)] dark:hover:text-[var(--color-brand-light)] focus:outline-none transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu Content -->
    <div class="container mx-auto px-0 max-w-7xl pointer-events-auto">
        <div id="mobile-menu" class="xl:hidden hidden bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl border border-white/20 dark:border-slate-700/50 mt-2 absolute w-[calc(100%-2rem)] md:w-full left-4 md:left-0 px-4 py-4 rounded-2xl shadow-2xl transition-all duration-300 z-[900] max-h-[80vh] overflow-y-auto">
            <div class="flex flex-col space-y-1">
                {primaryLinks.map(link => (
                    <a
                        href={link.href}
                        class={`block py-3 px-4 rounded-xl font-medium transition-all duration-200 hover:bg-gray-100 dark:hover:bg-slate-800 hover:text-[var(--color-brand)] dark:hover:text-[var(--color-brand-light)] ${isActive(link.href) ? 'text-[var(--color-brand)] dark:text-[var(--color-brand-light)] bg-gray-50 dark:bg-slate-800/80' : 'text-gray-700 dark:text-gray-200'}`}
                    >
                        {link.text}
                    </a>
                ))}

                {dropdowns.map(group => (
                    <div class="py-2">
                        <p class="px-4 text-[10px] font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">{group.label}</p>
                        {group.links.map(link => (
                            <a href={link.href} class="block py-2.5 px-4 rounded-xl font-medium transition-all hover:bg-gray-100 dark:hover:bg-slate-800 text-gray-700 dark:text-gray-200">
                                {link.text}
                            </a>
                        ))}
                    </div>
                ))}

                <a href={visitLink.href} class={`block py-3 px-4 rounded-xl font-medium transition-all duration-200 hover:bg-gray-100 dark:hover:bg-slate-800 hover:text-[var(--color-brand)] dark:hover:text-[var(--color-brand-light)] ${isActive(visitLink.href) ? 'bg-gray-50 dark:bg-slate-800/80' : ''} text-gray-700 dark:text-gray-200`}>
                    <span class="flex items-center gap-2 text-[var(--color-brand)] font-bold"><i class="fa-solid fa-hand-wave"></i> {visitLink.text}</span>
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    // Usa 'astro:page-load' no lugar de 'DOMContentLoaded' para SPA view transitions
    document.addEventListener('astro:page-load', () => {
        const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
        const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
        const themeToggleBtn = document.getElementById('theme-toggle');

        if (themeToggleBtn && themeToggleDarkIcon && themeToggleLightIcon) {
            let currentTheme = localStorage.getItem('theme');
            if (currentTheme === 'dark' || (!currentTheme && document.documentElement.classList.contains('dark'))) {
                themeToggleLightIcon.classList.remove('hidden');
                themeToggleDarkIcon.classList.add('hidden');
            } else {
                themeToggleDarkIcon.classList.remove('hidden');
                themeToggleLightIcon.classList.add('hidden');
            }

            themeToggleBtn.onclick = () => {
                const isDark = document.documentElement.classList.toggle('dark');
                if (isDark) {
                    localStorage.setItem('theme', 'dark');
                    themeToggleLightIcon.classList.remove('hidden');
                    themeToggleDarkIcon.classList.add('hidden');
                } else {
                    localStorage.setItem('theme', 'light');
                    themeToggleDarkIcon.classList.remove('hidden');
                    themeToggleLightIcon.classList.add('hidden');
                }
            };
        }

        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (btn && menu) {
            btn.onclick = () => {
                menu.classList.toggle('hidden');
            };
        }

        const mainNav = document.getElementById('mainNav');
        if (mainNav && mainNav.classList.contains('is-immersive')) {
            const handleScroll = () => {
                if (window.scrollY > window.innerHeight * 0.7) {
                    mainNav.classList.remove('opacity-0', '-translate-y-[150%]', 'pointer-events-none');
                } else {
                    mainNav.classList.add('opacity-0', '-translate-y-[150%]', 'pointer-events-none');
                }
            };
            window.addEventListener('scroll', handleScroll, { passive: true });
            handleScroll();
        }
    });
</script>
