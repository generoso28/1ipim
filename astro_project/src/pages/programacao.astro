---
import Layout from '../layouts/Layout.astro';
import { WP_REST_BASE } from '../config/api';
import { SITE } from '../config/seo';

interface ProgramacaoItem {
    id: number;
    tipo: string;
    titulo: string;
    subtitulo: string;
    descricao: string;
    horario: string;
    dia_semana: number | null;
    data: string | null;
    local: string;
    link: string;
    tag: string;
    tag_cor: string;
    tipo_evento: string;
    status: string;
    ordem: number;
}

const DIAS = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];

const FALLBACK: ProgramacaoItem[] = [
    {
        id: 0, tipo: 'semanal', titulo: 'Escola Bíblica Dominical', subtitulo: '', descricao: 'Às 9:00, no templo. A Escola Bíblica Dominical (EBD) é um ministério de ensino da igreja, dedicado ao estudo sistemático da Bíblia. Ela tem o propósito de instruir crianças, jovens e adultos na fé cristã, promovendo o crescimento espiritual e a aplicação prática das Escrituras na vida diária.', horario: '09:00', dia_semana: 0, data: null, local: 'Templo', link: '', tag: 'Doutrina', tag_cor: '#7ccece', tipo_evento: '', status: 'publicado', ordem: 10,
    },
    {
        id: 0, tipo: 'semanal', titulo: 'Culto Solene', subtitulo: '', descricao: 'Às 19:00, no Templo. O Culto Solene é o momento central de adoração da igreja, onde os crentes se reúnem para glorificar a Deus por meio da oração, do louvor, da pregação da Palavra e da comunhão.', horario: '19:00', dia_semana: 0, data: null, local: 'Templo', link: '', tag: 'Orações', tag_cor: '#7ace9f', tipo_evento: '', status: 'publicado', ordem: 20,
    },
    {
        id: 0, tipo: 'semanal', titulo: 'Reunião de Oração', subtitulo: '', descricao: 'Às 18:30, no espaço Get Up, nos reunimos semanalmente com o propósito de orar pela igreja, pelas missões, pelos enfermos e uns pelos outros, fortalecendo a comunhão e a fé da congregação. A prática contínua da oração mantém a igreja centrada na dependência de Deus e no fortalecimento espiritual de todos os membros, sendo o pilar sustentador de todos os demais ministérios da igreja.', horario: '18:30', dia_semana: 3, data: null, local: 'Espaço Get Up', link: '', tag: 'Orações', tag_cor: '#7ace9f', tipo_evento: '', status: 'publicado', ordem: 30,
    },
    {
        id: 0, tipo: 'semanal', titulo: 'Get Up', subtitulo: '', descricao: 'Às 19:30, no Espaço Get Up, o Get Up, ministério de jovens da igreja, se reúne para louvar a Deus, estudar Sua Palavra e ter um tempo de comunhão entre os irmãos. É um ministério dedicado ao fortalecimento espiritual dos jovens, buscando crescer na fé e no serviço a Deus.', horario: '19:30', dia_semana: 6, data: null, local: 'Espaço Get Up', link: 'https://www.instagram.com/juventude_getup/', tag: 'Comunhão', tag_cor: '#6fc7b0', tipo_evento: '', status: 'publicado', ordem: 40,
    },
];

let weekly: ProgramacaoItem[] = FALLBACK;
try {
    const response = await fetch(`${WP_REST_BASE}/programacao?tipo=semanal`, { headers: { Accept: 'application/json' } });
    if (response.ok) {
        const data = (await response.json()) as ProgramacaoItem[];
        if (Array.isArray(data) && data.length > 0) {
            weekly = data;
        }
    }
} catch {
    weekly = FALLBACK;
}

const ordered = [...weekly].sort(
    (a, b) => (a.dia_semana ?? 99) - (b.dia_semana ?? 99) || a.ordem - b.ordem || a.horario.localeCompare(b.horario),
);

const schedule = DIAS.map((day, index) => ({
    day,
    events: ordered.filter((item) => item.dia_semana === index),
})).filter((group) => group.events.length > 0);

function nextWeekday(day: number): string {
    const now = new Date();
    const date = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
    const diff = (day - date.getUTCDay() + 7) % 7;
    date.setUTCDate(date.getUTCDate() + diff);
    return date.toISOString().slice(0, 10);
}

function endTime(start: string): string {
    const [h, m] = start.split(':').map(Number);
    if (Number.isNaN(h) || Number.isNaN(m)) return start;
    const total = h * 60 + m + 90;
    return `${String(Math.floor(total / 60) % 24).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
}

const weeklyEvents = weekly
    .filter((item) => item.dia_semana !== null && item.horario)
    .map((item) => ({
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: item.titulo,
        description: item.descricao || item.subtitulo || item.titulo,
        startDate: `${nextWeekday(item.dia_semana as number)}T${item.horario}:00-03:00`,
        endDate: `${nextWeekday(item.dia_semana as number)}T${endTime(item.horario)}:00-03:00`,
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        eventStatus: 'https://schema.org/EventScheduled',
        isAccessibleForFree: true,
        location: {
            '@type': 'Place',
            name: SITE.name,
            address: { '@type': 'PostalAddress', ...SITE.address },
            geo: { '@type': 'GeoCoordinates', ...SITE.geo },
        },
        organizer: { '@id': `${SITE.url}/#church` },
    }));
---
<Layout title="Programação - Primeira Igreja Presbiteriana Independente de Machado" description="Horários dos cultos e atividades da 1IPIM: Escola Bíblica Dominical, Culto Solene, Get Up, ensaios e encontros durante a semana." footerBgClass="bg-white dark:bg-slate-900" schema={weeklyEvents}>
    <section class="py-20 mt-16 bg-white dark:bg-slate-900 transition-colors min-h-screen">
        <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
            <div class="text-center max-w-2xl mx-auto mb-16 scroll-card">
                <h1 class="font-extrabold text-3xl md:text-4xl text-gray-900 dark:text-white mb-2">Nossa programação</h1>
                <p class="text-gray-500 dark:text-gray-400 text-lg">Confira todos os encontros que acontecem na nossa igreja</p>
            </div>

            <div class="flex flex-col lg:flex-row gap-8 items-start">
                <!-- Schedule Column -->
                <div class="w-full lg:w-3/4">
                    <div id="weekly-groups" class="bg-gray-50/50 dark:bg-slate-800/20 rounded-[2.5rem] p-6 md:p-10 shadow-sm border border-gray-100 dark:border-slate-700 flex flex-col space-y-12">
                        {schedule.map(group => (
                            <div class="scroll-card relative">
                                <h3 class="font-extrabold text-3xl text-gray-900 dark:text-white mb-8 flex items-center gap-4">
                                    <span class="w-14 h-14 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center shadow-sm border border-gray-100 dark:border-slate-700 shrink-0 text-xl text-[var(--color-brand)]">
                                        <i class="fa-regular fa-calendar-check text-[var(--color-brand)]"></i>
                                    </span>
                                    {group.day}
                                </h3>
                                <div class="space-y-4 md:pl-18">
                                    {group.events.map(event => (
                                        <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 md:p-8 border border-gray-100 dark:border-slate-700 hover:shadow-xl hover:-translate-y-1 hover:border-[var(--color-brand)]/30 transition-all duration-300 group/event flex flex-col relative overflow-hidden" data-horario={event.horario} data-titulo={event.titulo} data-descricao={event.descricao}>
                                            <div class="absolute right-0 top-0 w-32 h-32 rounded-full blur-[50px] opacity-10 pointer-events-none group-hover/event:opacity-20 transition-opacity" style={`background-color: ${event.tag_cor || '#7ccece'};`}></div>
                                            <div class="flex items-center gap-3 mb-4 relative z-10">
                                                {event.link ? (
                                                    <a href={event.link} target="_blank" rel="nofollow" class="font-bold text-xl text-gray-900 dark:text-white hover:text-[var(--color-brand)] transition-colors">
                                                        {event.titulo} <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-50 ml-1"></i>
                                                    </a>
                                                ) : (
                                                    <h6 class="font-bold text-xl text-gray-900 dark:text-white m-0">{event.titulo}</h6>
                                                )}
                                                {event.tag && (
                                                    <span class="text-gray-900 text-[10px] px-2.5 py-1 rounded font-bold uppercase tracking-wider" style={`background-color: ${event.tag_cor || '#7ccece'};`}>
                                                        {event.tag}
                                                    </span>
                                                )}
                                            </div>
                                            <div class="flex items-start gap-4 relative z-10">
                                                <i class="fa-regular fa-clock text-[var(--color-brand)] text-xl mt-0.5 shrink-0 opacity-80"></i>
                                                <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base leading-relaxed">
                                                    {event.horario && <strong class="text-gray-900 dark:text-white">{event.horario} · </strong>}
                                                    {event.descricao}
                                                </p>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Lateral Promo Column -->
                <div class="w-full lg:w-1/4 flex flex-col gap-6 lg:sticky lg:top-32">
                    <!-- Promo Eventos Especiais -->
                    <a href="/eventos" class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl p-6 md:p-8 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 text-white scroll-card relative overflow-hidden group flex flex-col min-h-[300px]">
                        <div class="absolute right-0 top-0 w-32 h-32 bg-white/20 rounded-full blur-2xl translate-x-1/2 -translate-y-1/2 pointer-events-none group-hover:scale-150 transition-transform duration-700"></div>

                        <div class="relative z-10 flex flex-col flex-1 h-full">
                            <div class="w-12 h-12 bg-white/20 text-white rounded-2xl flex items-center justify-center mb-6 shadow-sm backdrop-blur-sm group-hover:rotate-12 transition-transform group-hover:scale-110">
                                <i class="fa-solid fa-calendar-days text-xl"></i>
                            </div>
                            <h5 class="font-extrabold text-2xl mb-3 leading-tight drop-shadow-md">Eventos & Calendário</h5>
                            <p class="text-white/90 mb-8 text-sm leading-relaxed font-medium">Acampamentos, conferências e congressos imperdíveis marcados pro nosso ano.</p>

                            <div class="mt-auto inline-flex items-center justify-center gap-2 font-extrabold text-sm tracking-wide uppercase bg-white/10 group-hover:bg-white text-white group-hover:text-indigo-600 px-4 py-3.5 rounded-xl transition-all duration-300 w-full border border-white/20 shadow-sm text-center">
                                Ver eventos <i class="fa-solid fa-arrow-right ml-1"></i>
                            </div>
                        </div>
                    </a>

                    <!-- PGs -->
                    <div class="bg-gradient-to-br from-[var(--color-brand)] to-[var(--color-brand-dark)] rounded-3xl p-6 md:p-8 shadow-lg hover:shadow-xl transition-shadow text-white scroll-card relative overflow-hidden group flex flex-col min-h-[250px]">
                        <div class="absolute -right-4 -bottom-4 text-white/10 text-8xl group-hover:scale-110 group-hover:-rotate-12 transition-transform duration-500">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div class="relative z-10 flex-1 flex flex-col h-full">
                            <h5 class="font-extrabold text-2xl mb-3 drop-shadow-md">Pequenos grupos</h5>
                            <p class="text-white/90 mb-8 text-sm leading-relaxed font-medium">
                                Diversos grupos pela cidade. Encontre o mais próximo de sua casa ou faixa etária!
                            </p>
                            <a href="/pg" class="mt-auto inline-flex items-center justify-center gap-2 bg-white text-[var(--color-brand)] px-6 py-3.5 rounded-xl font-bold hover:scale-105 transition-transform shadow-md w-full text-sm text-center">
                                Conhecer Grupos <i class="fa-solid fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    import { WP_REST_BASE } from '../config/api';

    interface Item {
        titulo: string;
        descricao: string;
        link: string;
        tag: string;
        tag_cor: string;
        horario: string;
        dia_semana: number | null;
        ordem: number;
    }

    const DIAS = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];

    const esc = (value: unknown): string =>
        String(value ?? '').replace(/[&<>"']/g, (ch) => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[ch] as string));

    function card(item: Item): string {
        const tag = item.tag
            ? `<span class="text-gray-900 text-[10px] px-2.5 py-1 rounded font-bold uppercase tracking-wider" style="background-color:${esc(item.tag_cor || '#7ccece')};">${esc(item.tag)}</span>`
            : '';
        const title = item.link
            ? `<a href="${esc(item.link)}" target="_blank" rel="nofollow" class="font-bold text-xl text-gray-900 dark:text-white hover:text-[var(--color-brand)] transition-colors">${esc(item.titulo)} <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-50 ml-1"></i></a>`
            : `<h6 class="font-bold text-xl text-gray-900 dark:text-white m-0">${esc(item.titulo)}</h6>`;
        const time = item.horario ? `<strong class="text-gray-900 dark:text-white">${esc(item.horario)} · </strong>` : '';

        return `
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 md:p-8 border border-gray-100 dark:border-slate-700 hover:shadow-xl hover:-translate-y-1 hover:border-[var(--color-brand)]/30 transition-all duration-300 group/event flex flex-col relative overflow-hidden">
                <div class="absolute right-0 top-0 w-32 h-32 rounded-full blur-[50px] opacity-10 pointer-events-none group-hover/event:opacity-20 transition-opacity" style="background-color:${esc(item.tag_cor || '#7ccece')};"></div>
                <div class="flex items-center gap-3 mb-4 relative z-10">${title}${tag}</div>
                <div class="flex items-start gap-4 relative z-10">
                    <i class="fa-regular fa-clock text-[var(--color-brand)] text-xl mt-0.5 shrink-0 opacity-80"></i>
                    <p class="text-gray-600 dark:text-gray-300 text-sm md:text-base leading-relaxed">${time}${esc(item.descricao)}</p>
                </div>
            </div>
        `;
    }

    async function refresh(): Promise<void> {
        const container = document.getElementById('weekly-groups');
        if (!container) return;
        try {
            const response = await fetch(`${WP_REST_BASE}/programacao?tipo=semanal`, { headers: { Accept: 'application/json' } });
            if (!response.ok) return;
            const items = (await response.json()) as Item[];
            if (!Array.isArray(items) || items.length === 0) return;

            const weeks = DIAS.map((day, index) => ({
                day,
                events: items
                    .filter((item) => item.dia_semana === index)
                    .sort((a, b) => a.ordem - b.ordem || a.horario.localeCompare(b.horario)),
            })).filter((group) => group.events.length > 0);

            container.innerHTML = weeks.map((group) => `
                <div class="relative">
                    <h3 class="font-extrabold text-3xl text-gray-900 dark:text-white mb-8 flex items-center gap-4">
                        <span class="w-14 h-14 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center shadow-sm border border-gray-100 dark:border-slate-700 shrink-0 text-xl text-[var(--color-brand)]">
                            <i class="fa-regular fa-calendar-check text-[var(--color-brand)]"></i>
                        </span>
                        ${esc(group.day)}
                    </h3>
                    <div class="space-y-4 md:pl-18">${group.events.map(card).join('')}</div>
                </div>
            `).join('');
        } catch {
            // Mantém a renderização feita no build.
        }
    }

    refresh();
</script>
